# Скопируйте в .env.stage.local (файл исключён из Git).
# Общий вход staging (Basic Auth), а не учётная запись пользователя приложения.
# Секреты без VITE_: их читает только Node.js, в браузер они не передаются.
DEV_STAGE_BASIC_AUTH_USER=''
DEV_STAGE_BASIC_AUTH_PASSWORD=''
# Если в значении есть $, экранируйте его как \$: Vite разворачивает $VARIABLE.
