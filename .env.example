# Скопируйте в .env.development.local для личных переопределений.
# Любые VITE_* попадают в бандл: секретов здесь быть не может.
VITE_APP_ENV=dev
# Origin API без пути. Пусто — тот же origin, что у приложения (пути /api/v1/... как в контракте).
VITE_API_ORIGIN=
# Только для dev-сервера Vite: куда проксировать /api. В браузер не попадает.
DEV_API_TARGET=http://127.0.0.1:8081
# Необязательный приёмник телеметрии операций (POST JSON через sendBeacon). Пусто — не отправлять.
VITE_TELEMETRY_ENDPOINT=
